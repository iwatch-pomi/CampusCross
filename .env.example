# Supabase（ダッシュボード → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
# 通知メールの送信先（相手の通知用アドレス）を読むためにだけ使う。サーバー側専用。絶対に公開しない
SUPABASE_SERVICE_ROLE_KEY=

# 登録を許可するメールドメイン（カンマ区切り）。フォームでの事前チェック用で、最終判定はDB
ALLOWED_EMAIL_DOMAINS=hiroshima-u.ac.jp

# 通知メール（Resend）。未設定なら通知は送らずログに出すだけ
RESEND_API_KEY=
NOTIFY_FROM=Campus-Cross <noreply@example.com>
# 通知メール内のリンクに使う
APP_URL=http://localhost:3000
